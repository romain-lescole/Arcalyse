<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Profil="http://Profil/schemas/Profil/_ProfilDef/0" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xsi:schemaLocation="http://Profil/schemas/Profil/_ProfilDef/0 Profil.profile.uml#_ProfilDef">
  <uml:Model xmi:id="_Systeme" name="Systeme">
    <packageImport xmi:id="_Systeme_imp_types">
      <importedPackage xmi:type="uml:Package" href="lib/Types.uml#_Types"/>
    </packageImport>
    <packageImport xmi:id="_Systeme_imp_prim">
      <importedPackage xmi:type="uml:Model" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#_0"/>
    </packageImport>
    <packagedElement xmi:type="uml:Class" xmi:id="_Drone" name="Drone">
      <generalization xmi:id="_Drone_gen">
        <general xmi:type="uml:Class" href="lib/Types.uml#_Aeronef"/>
      </generalization>
      <ownedAttribute xmi:id="_Drone_moteur" name="moteur" aggregation="composite">
        <type xmi:type="uml:Class" href="lib/Types.uml#_Moteur"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_Drone_masse" name="masse">
        <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Real"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_Drone_station" name="station">
        <type xmi:type="uml:Class" href="Station.uml#_Station"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_Drone_journal" name="journal">
        <type xmi:type="uml:Class" href="Journal.mdxml#_Journal"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" href="Sous-systeme.uml#_SousSysteme"/>
    <profileApplication xmi:id="_Systeme_app">
      <appliedProfile href="Profil.profile.uml#_ProfilDef"/>
    </profileApplication>
  </uml:Model>
</xmi:XMI>
