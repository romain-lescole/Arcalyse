{
  "name": "arcalyse",
  "version": "1.0.0",
  "private": true,
  "description": "Explorateur et analyseur autonome (hors ligne) de modèles Capella — sources découpées, assemblées en un fichier HTML unique par build.js",
  "scripts": {
    "build": "node build.js",
    "build:propre": "node build.js --no-markers",
    "build:en": "node build.js --lang en",
    "build:multi": "node build.js --lang multi",
    "livraison": "node build.js --livraison",
    "index": "node tools/index.js",
    "split": "node tools/split.js",
    "smoke": "node tests/smoke.js",
    "oracles": "node tests/oracles.js",
    "oracles:update": "node tests/oracles.js --update",
    "lint": "eslint",
    "textes": "node tools/textes.js",
    "textes:en": "node tools/textes.js --en"
  }
}
